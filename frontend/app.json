{
  "expo": {
    "name": "RF Photos",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "rfphotos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rfalphabet.rfphotos",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Browse and organise your photos privately",
        "NSPhotoLibraryAddUsageDescription": "Save your edits and captures to Photos",
        "NSCameraUsageDescription": "Take photos, videos and document scans",
        "NSMicrophoneUsageDescription": "Record sound with your videos",
        "NSFaceIDUsageDescription": "Unlock your private Vault"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FF5E00"
      },
      "package": "com.rfalphabet.rfphotos",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "RF Photos",
      "shortName": "RF Photos",
      "themeColor": "#FF5E00"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F6F8"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-video",
      "expo-sharing",
      "@react-native-vector-icons/ionicons",
      [
        "expo-media-library",
        {
          "photosPermission": "Browse and organise your photos privately",
          "savePhotosPermission": "Save your edits and captures to Photos",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Take photos, videos and document scans",
          "microphonePermission": "Record sound with your videos",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Import photos into RF Photos",
          "cameraPermission": "Scan documents with your camera"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your private Vault"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}